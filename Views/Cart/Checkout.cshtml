@model HuflitRestaurant.Models.CartViewModel

@{
    ViewBag.Title = "Thanh toán - HUFLIT RESTAURANT";
    decimal discount = ViewBag.Discount != null ? (decimal)ViewBag.Discount : 0;
    string appliedCode = ViewBag.CouponCode ?? "";
}

<div class="checkout-simple-container" style="max-width: 1100px;">
    <h1 class="checkout-simple-title">XÁC NHẬN ĐẶT HÀNG</h1>

    <div class="checkout-grid-layout">

        <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC -->
        @using (Html.BeginForm("ProcessCheckout", "Cart", FormMethod.Post, new { id = "checkoutForm" }))
        {
            <div class="checkout-form-box">
                <h2 class="checkout-section-title">Thông tin giao hàng</h2>

                <div class="checkout-field-group">
                    <label class="checkout-field-label">Địa chỉ nhận hàng</label>
                    <input type="text" name="DiaChi" value="36/17 Trịnh Đình Thảo" placeholder="Số nhà, tên đường, phường/xã..." class="checkout-input-custom" required />
                </div>

                <div class="checkout-field-group">
                    <label class="checkout-field-label">Số điện thoại liên hệ</label>
                    <input type="text" name="SoDienThoai" value="0901234567" placeholder="0901234567" class="checkout-input-custom" required />
                </div>

                <div class="checkout-field-group">
                    <label class="checkout-field-label">Ghi chú đơn hàng (nếu có)</label>
                    <textarea name="GhiChu" rows="3" placeholder="Ít cay, lấy thêm đũa..." class="checkout-input-custom"></textarea>
                </div>

                <h2 class="checkout-section-title" style="margin-top: 28px;">Phương thức thanh toán</h2>
                <div class="payment-radio-group">
                    <label class="payment-radio-label">
                        <input type="radio" name="PaymentMethod" value="COD" />
                        <span>Thanh toán khi nhận hàng (COD)</span>
                    </label>
                    <label class="payment-radio-label">
                        <input type="radio" name="PaymentMethod" value="Bank" checked />
                        <span>Chuyển khoản / Quét mã QR (VietQR, Momo, ZaloPay, Banking)</span>
                    </label>
                </div>
            </div>
        }

        <!-- CỘT PHẢI: ĐƠN HÀNG CỦA BẠN & MÃ GIẢM GIÁ -->
        <div class="checkout-order-card">
            <h2 class="checkout-section-title">Đơn hàng của bạn</h2>

            <div class="order-item-list">
                @if (Model != null && Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        string imgPath = !string.IsNullOrEmpty(item.HinhAnh) ? Url.Content(item.HinhAnh) : "https://via.placeholder.com/60";

                        <div class="order-item-card">
                            <img src="@imgPath" alt="@item.Ten" class="order-item-thumb" onerror="this.onerror=null; this.src='https://via.placeholder.com/60';" />
                            <div class="order-item-details">
                                <span class="order-item-name-text">@item.Ten</span>
                                <span class="order-item-qty-text">Số lượng: @item.SoLuong</span>
                            </div>
                            <span class="order-item-price-text">@item.Gia.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                        </div>
                    }
                }
            </div>

            <!-- Khung nhập mã giảm giá -->
            <div style="border-top: 1px solid #E5E7EB; padding-top: 12px; margin-top: 10px;">
                <label style="font-size: 13px; font-weight: 700; color: #374151;">Mã giảm giá</label>
                @using (Html.BeginForm("ApplyCoupon", "Cart", FormMethod.Post, new { @class = "coupon-box" }))
                {
                    <input type="text" name="couponCode" value="@appliedCode" placeholder="Nhập mã (VD: HUFLIT10K)" class="input-coupon" required />
                    <button type="submit" class="btn-apply-coupon">Áp dụng</button>
                }

                @if (TempData["CouponSuccess"] != null)
                {
                    <div class="coupon-msg-success">&#10004; @TempData["CouponSuccess"]</div>
                }
                @if (TempData["CouponError"] != null)
                {
                    <div class="coupon-msg-error">&#10008; @TempData["CouponError"]</div>
                }
            </div>

            <!-- Tóm tắt chi phí -->
            @{
                decimal tamTinh = (Model != null && Model.Items != null && Model.Items.Any()) ? Model.Items.Sum(x => x.Gia * x.SoLuong) : 0;
                decimal tongThanhToan = tamTinh - discount;
                if (tongThanhToan < 0) { tongThanhToan = 0; }
            }

            <div class="order-summary-footer">
                @if (discount > 0)
                {
                    <div class="order-total-row" style="margin-bottom: 8px; font-size: 14px; color: #6B7280;">
                        <span>Tạm tính</span>
                        <span>@tamTinh.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                    </div>
                    <div class="order-total-row" style="margin-bottom: 8px; font-size: 14px; color: #10B981;">
                        <span>Giảm giá</span>
                        <span>-@discount.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                    </div>
                }

                <div class="order-total-row">
                    <span class="order-total-title">Tổng thanh toán</span>
                    <span class="order-total-price">@tongThanhToan.ToString("#,##0", new System.Globalization.CultureInfo("vi-VN")) đ</span>
                </div>
            </div>

            <button type="button" onclick="document.getElementById('checkoutForm').submit();" class="btn-submit-side">
                XÁC NHẬN ĐẶT HÀNG
            </button>
        </div>

    </div>
</div>